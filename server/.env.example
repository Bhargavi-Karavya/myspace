PORT=5000
# Local Docker: postgresql://myspace:myspace_password@localhost:5434/myspace
# Neon production: use the POOLED connection string (?sslmode=require)
DATABASE_URL=postgresql://myspace:myspace_password@localhost:5434/myspace
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Phase 4.1 — isolated embedding experiment (not used for chat/memory storage)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
